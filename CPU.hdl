CHIP CPU {
    IN  inM[16], instruction[16], reset;
    OUT outM[16], writeM, addressM[15], pc[15];

    PARTS:
    Not(in=instruction[15], out=isAInst);
    Mux16(a=aluOut, b=instruction, sel=isAInst, out=aRegIn);
    
    Or(a=isAInst, b=instruction[5], out=loadA);
    ARegister(in=aRegIn, load=loadA, out=aRegOut, out[0..14]=addressM);
    
    And(a=instruction[15], b=instruction[4], out=loadD);
    DRegister(in=aluOut, load=loadD, out=dRegOut);
    
    Mux16(a=aRegOut, b=inM, sel=instruction[12], out=aluY);
    ALU(x=dRegOut, y=aluY, zx=instruction[11], nx=instruction[10], zy=instruction[9], ny=instruction[8], f=instruction[7], no=instruction[6], out=aluOut, out=outM, zr=zr, ng=ng);
    
    And(a=instruction[15], b=instruction[3], out=writeM);
    
    // Jump logic
    Or(a=zr, b=ng, out=lteZero);
    Not(in=lteZero, out=gtZero);
    And(a=instruction[0], b=gtZero, out=jgt);
    And(a=instruction[1], b=zr, out=jeq);
    And(a=instruction[2], b=ng, out=jlt);
    Or(a=jgt, b=jeq, out=jge);
    Or(a=jge, b=jlt, out=jumpCond);
    And(a=instruction[15], b=jumpCond, out=doJump);
    
    PC(in=aRegOut, load=doJump, inc=true, reset=reset, out[0..14]=pc);
}